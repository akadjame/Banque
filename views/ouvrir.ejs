<%- include('partials/head') %>
<main class="form-page"><div class="container">
  <form class="form-card" method="post" action="/ouvrir-un-livret" autocomplete="on">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h1>Ouvrir mon compte</h1>
    <p class="muted">Gratuit, sans engagement, en 5 minutes.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% const pro = values.account_type === 'pro'; %>

    <fieldset>
      <legend>Je suis</legend>
      <div class="choice" id="type-choice">
        <label><input type="radio" name="account_type" value="particulier" <%= !pro ? 'checked' : '' %>> <span><strong>Un particulier</strong><br><span class="small muted">Livrets, comptes à terme, compte joint, livret enfant</span></span></label>
        <label><input type="radio" name="account_type" value="pro" <%= pro ? 'checked' : '' %>> <span><strong>Une entreprise</strong><br><span class="small muted">Placez la trésorerie de votre société ou activité</span></span></label>
      </div>
    </fieldset>

    <fieldset id="company-fields" <%= pro ? '' : 'hidden' %>>
      <legend>Mon entreprise</legend>
      <label for="company_name">Raison sociale</label><input id="company_name" name="company_name" value="<%= values.company_name || '' %>" autocomplete="organization">
      <div class="row">
        <div><label for="siren">SIREN</label><input id="siren" name="siren" inputmode="numeric" maxlength="11" value="<%= values.siren || '' %>" placeholder="9 chiffres"></div>
        <div><label for="legal_form">Forme juridique</label><select id="legal_form" name="legal_form"><option value="">Choisir…</option><% LEGAL_FORMS.forEach(f => { %><option <%= values.legal_form === f ? 'selected' : '' %>><%= f %></option><% }) %></select></div>
      </div>
      <label for="company_role">Votre fonction</label><input id="company_role" name="company_role" value="<%= values.company_role || '' %>" placeholder="Gérant, président…">
      <p class="small muted">Le représentant légal ouvre le compte en son nom pour l'entreprise. Un extrait Kbis vous sera demandé lors de la validation.</p>
    </fieldset>

    <fieldset>
      <legend>1. Mon produit d'épargne</legend>
      <div class="choice">
        <% offer.products.filter(p => p.kind !== 'junior').forEach((p, i) => { %>
        <label data-audience="<%= p.audience %>" <%= (p.audience === 'pro') !== pro && p.audience !== 'tous' ? 'hidden' : '' %>><input type="radio" name="product_id" value="<%= p.id %>" <%= values.product_id == p.id ? 'checked' : '' %>>
          <span><strong><%= p.name %></strong><br><span class="small muted"><%= rate(headlineRate(p)) %> · <%= productRateText(p) %></span></span></label>
        <% }) %>
      </div>
    </fieldset>

    <fieldset>
      <legend>2. <span id="identity-title"><%= pro ? 'Le représentant légal' : 'Mon identité' %></span></legend>
      <div class="row-3">
        <div><label for="civility">Civilité</label>
          <select id="civility" name="civility"><option value="M." <%= values.civility === 'M.' ? 'selected' : '' %>>M.</option><option value="Mme" <%= values.civility === 'Mme' ? 'selected' : '' %>>Mme</option></select></div>
        <div><label for="birth_date">Date de naissance</label><input type="date" id="birth_date" name="birth_date" value="<%= values.birth_date || '' %>" required></div>
      </div>
      <div class="row">
        <div><label for="first_name">Prénom</label><input id="first_name" name="first_name" value="<%= values.first_name || '' %>" required autocomplete="given-name"></div>
        <div><label for="last_name">Nom</label><input id="last_name" name="last_name" value="<%= values.last_name || '' %>" required autocomplete="family-name"></div>
      </div>
      <div class="row">
        <div><label for="email">E-mail</label><input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></div>
        <div><label for="phone">Téléphone mobile</label><input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" autocomplete="tel"></div>
      </div>
      <label for="address">Adresse</label><input id="address" name="address" value="<%= values.address || '' %>" required autocomplete="street-address">
      <div class="row-3">
        <div><label for="postal_code">Code postal</label><input id="postal_code" name="postal_code" value="<%= values.postal_code || '' %>" required autocomplete="postal-code"></div>
        <div><label for="city">Ville</label><input id="city" name="city" value="<%= values.city || '' %>" required autocomplete="address-level2"></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>3. Mon compte de référence</legend>
      <p class="small muted">Votre compte courant (ou celui de l'entreprise), dans une autre banque. Les versements partent de ce compte et les retraits y sont reversés.</p>
      <label for="reference_iban">IBAN</label><input id="reference_iban" name="reference_iban" class="mono" value="<%= values.reference_iban ? iban(values.reference_iban) : '' %>" placeholder="FR76 ...." required>
      <label for="reference_holder">Titulaire du compte</label><input id="reference_holder" name="reference_holder" value="<%= values.reference_holder || '' %>" required>
    </fieldset>

    <fieldset>
      <legend>4. Mes accès</legend>
      <div class="row">
        <div><label for="password">Mot de passe</label><input type="password" id="password" name="password" minlength="10" required autocomplete="new-password"></div>
        <div><label for="password2">Confirmation</label><input type="password" id="password2" name="password2" minlength="10" required autocomplete="new-password"></div>
      </div>
      <p class="small muted">10 caractères minimum avec une majuscule, une minuscule et un chiffre.</p>
      <label for="parrain">Code parrain (facultatif)</label><input id="parrain" name="parrain" value="<%= values.parrain || '' %>">
    </fieldset>

    <label class="check" style="margin-top:22px"><input type="checkbox" name="cgu" value="1" required> <span>J'accepte les conditions générales et je certifie être majeur et résident fiscal français.</span></label>
    <button class="btn btn-violet btn-block" style="margin-top:22px" type="submit">Valider ma demande</button>
    <p class="small muted center">Déjà client ? <a href="/connexion">Connectez-vous</a></p>
  </form>
</div></main>
<%- include('partials/foot') %>
