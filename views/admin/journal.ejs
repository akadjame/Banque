<%- include('../partials/admin-top') %>
<div class="page-head"><h1>Journal des actions</h1></div>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Date</th><th>Admin</th><th>Action</th><th>Détails</th></tr></thead>
    <tbody><% logs.forEach(l => { %>
      <tr><td class="small"><%= datetime(l.created_at) %></td><td class="small"><%= l.first_name || '—' %> <%= l.last_name || '' %></td><td><span class="chip"><%= l.action %></span></td><td class="small mono" style="word-break:break-all"><%= l.details %></td></tr>
    <% }) %></tbody>
  </table>
</div>
<%- include('../partials/admin-bottom') %>
