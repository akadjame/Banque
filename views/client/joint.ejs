<%- include('../partials/client-top') %>
<div class="page-head"><h1>Compte joint</h1></div>
<p class="muted" style="margin-top:-10px">Épargnez à deux sur le même livret : chacun voit le compte dans son espace, peut l'alimenter et demander des retraits vers son propre compte de référence.</p>

<% if (invites.length) { %>
<div class="card">
  <h2>Invitations reçues</h2>
  <% invites.forEach(i => { %>
  <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 0">
    <div><strong><%= i.first_name %> <%= i.last_name %></strong> vous invite sur son <strong><%= i.product_name %></strong><div class="small muted">le <%= date(i.created_at) %></div></div>
    <div class="actions">
      <form method="post" action="/espace/compte-joint/<%= i.id %>/accepter"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-success btn-sm">Accepter</button></form>
      <form method="post" action="/espace/compte-joint/<%= i.id %>/refuser"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-light btn-sm">Refuser</button></form>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<div class="grid grid-2">
  <div class="card">
    <h2>Mes comptes joints</h2>
    <% if (!joint.length) { %><p class="muted">Aucun compte joint pour l'instant.</p><% } %>
    <% joint.forEach(a => { const other = a.user_id === user.id ? a.coHolder : a.holder; %>
      <p><a href="/espace/compte/<%= a.id %>"><strong><%= a.displayName %></strong></a> — <%= eur(a.balance_cents) %><br><span class="small muted">avec <%= other.first_name %> <%= other.last_name %></span></p>
    <% }) %>
  </div>
  <form class="card" method="post" action="/espace/compte-joint">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>Inviter un cotitulaire</h2>
    <% if (!own.length) { %><p class="muted">Aucun de vos comptes ne peut être transformé en compte joint.</p><% } else { %>
    <label for="account_id">Compte à partager</label>
    <select id="account_id" name="account_id"><% own.forEach(a => { %><option value="<%= a.id %>"><%= a.displayName %> — <%= eur(a.balance_cents) %></option><% }) %></select>
    <label for="email">E-mail de votre cotitulaire</label>
    <input type="email" id="email" name="email" required placeholder="prenom@exemple.fr">
    <p class="small muted">Votre cotitulaire doit être client (il peut ouvrir son compte gratuitement en ligne avec cette adresse). Il recevra l'invitation dans son espace.</p>
    <button class="btn btn-violet">Envoyer l'invitation</button>
    <% } %>
  </form>
</div>

<% if (sent.length) { %>
<div class="card">
  <h2>Invitations envoyées</h2>
  <table><% sent.forEach(i => { %>
    <tr><td><%= i.to_email %><div class="small muted"><%= i.product_name %> · <%= date(i.created_at) %></div></td>
      <td><span class="chip <%= { en_attente: 'orange', acceptee: 'green', refusee: 'red', annulee: '' }[i.status] %>"><%= { en_attente: 'En attente', acceptee: 'Acceptée', refusee: 'Refusée', annulee: 'Annulée' }[i.status] %></span></td>
      <td style="text-align:right"><% if (i.status === 'en_attente') { %><form method="post" action="/espace/compte-joint/<%= i.id %>/annuler"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-light btn-sm">Annuler</button></form><% } %></td></tr>
  <% }) %></table>
</div>
<% } %>
<%- include('../partials/client-bottom') %>
