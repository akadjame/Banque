<%- include('../partials/client-top') %>
<div class="page-head"><h1>Parrainage</h1></div>
<div class="balance-card" style="margin-bottom:22px">
  <div class="label">Gagnez <strong><%= eur(offer.referrer) %></strong> par filleul, votre filleul reçoit <strong><%= eur(offer.referee) %></strong></div>
  <div class="value mono" style="margin-top:8px"><%= user.referral_code %></div>
  <div class="actions" style="margin-top:14px;position:relative;z-index:1">
    <button class="btn btn-cyan btn-sm" data-copy="<%= user.referral_code %>">Copier le code</button>
    <button class="btn btn-light btn-sm" data-copy="<%= link %>">Copier le lien</button>
  </div>
</div>
<div class="card">
  <h2>Mes filleuls (<%= filleuls.length %>)</h2>
  <% if (!filleuls.length) { %><p class="muted">Aucun filleul pour le moment. Partagez votre code !</p><% } %>
  <table>
    <% filleuls.forEach(f => { %>
    <tr><td><%= f.first_name %> <%= f.last_name[0] %>.</td><td class="small muted">inscrit le <%= date(f.created_at) %></td>
      <td><span class="chip <%= f.referral_paid ? 'green' : 'orange' %>"><%= f.referral_paid ? 'Prime versée' : 'En attente' %></span></td></tr>
    <% }) %>
  </table>
</div>
<%- include('../partials/client-bottom') %>
