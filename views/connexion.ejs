<%- include('partials/head') %>
<main class="form-page"><div class="container">
  <form class="form-card narrow" method="post" action="/connexion">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <h1>Espace client</h1>
    <%- include('partials/flash') %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <label for="email">E-mail</label><input type="email" id="email" name="email" value="<%= email %>" required autocomplete="username" autofocus>
    <label for="password">Mot de passe</label><input type="password" id="password" name="password" required autocomplete="current-password">
    <button class="btn btn-violet btn-block" style="margin-top:22px" type="submit">Me connecter</button>
    <p class="small muted center">Mot de passe oublié ? Contactez le service client au <%= bank.supportPhone %>.</p>
    <p class="small center">Pas encore client ? <a href="/ouvrir-un-livret">Ouvrir un livret</a></p>
  </form>
</div></main>
<%- include('partials/foot') %>
