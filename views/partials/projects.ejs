<div class="grid grid-4" style="margin-bottom:22px">
  <div class="stat"><div class="k">Projets financés</div><div class="v"><%= totals.count %></div></div>
  <div class="stat"><div class="k">Logements</div><div class="v"><%= totals.units.toLocaleString('fr-FR') %></div></div>
  <div class="stat"><div class="k">Montant engagé</div><div class="v"><%= eur(totals.amount).replace(',00', '') %></div></div>
  <div class="stat"><div class="k">Projets livrés</div><div class="v"><%= totals.delivered %></div></div>
</div>
<% if (!projects.length) { %>
  <div class="card"><p class="muted">Les premiers projets financés seront présentés ici dès leur lancement.</p></div>
<% } %>
<div class="grid grid-3">
  <% projects.forEach(p => { %>
  <article class="card" style="margin:0;display:flex;flex-direction:column;gap:8px">
    <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;flex-wrap:wrap">
      <span class="chip <%= { a_venir: 'orange', en_cours: 'cyan', livre: 'green' }[p.status] %>"><%= projectStatus[p.status] %></span>
      <% if (p.is_example) { %><span class="chip">Exemple</span><% } %>
    </div>
    <h3 style="margin:0;font-size:1.1rem"><%= p.title %></h3>
    <div class="small muted"><%= [p.city, p.partner].filter(Boolean).join(' · ') %></div>
    <% if (p.description) { %><p class="small" style="margin:0;white-space:pre-wrap"><%= p.description %></p><% } %>
    <div style="display:flex;gap:18px;margin-top:auto;padding-top:8px;border-top:1px solid var(--line)">
      <% if (p.housing_units) { %><div><strong><%= p.housing_units %></strong> <span class="small muted">logements</span></div><% } %>
      <% if (p.amount_cents) { %><div><strong><%= eur(p.amount_cents).replace(',00', '') %></strong> <span class="small muted">financés</span></div><% } %>
    </div>
  </article>
  <% }) %>
</div>
